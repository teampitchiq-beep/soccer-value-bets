def league_name(lid):
    return LEAGUE_NAMES.get(int(lid), f"League {lid}")

# ============ LEAGUES TO FETCH ============
LEAGUES_TO_FETCH  = TOP_10_LEAGUES
DEFAULT_LEAGUE_ID = 1

# ============ PIPELINE BEHAVIOR ============
AUTO_FETCH    = True
FORCE_REFRESH = False

# ============ MODEL SETTINGS (ridge Poisson model) ============
HALF_LIFE_DAYS = 365.0   # match weight halves every N days
RIDGE          = 10.0    # shrinkage toward league average (higher = more shrinkage)
XG_WEIGHT      = 0.7     # target = 0.7*xG + 0.3*actual goals

# ============ MODEL CALIBRATION ============
# Walk-forward tested: 1.06 gives the best log loss. (Old value 1.10 was for the old model.)
LAMBDA_BOOST    = 1.06
OVER_THRESHOLD  = 0.50

# ============ CONFIDENCE BANDS ============
# Re-based on walk-forward hit rates (HIGH over >=0.65 hit ~67%, >=0.70 ~77%)
HIGH_CONF_OVER_PROB   = 0.65
HIGH_CONF_UNDER_PROB  = 0.40
MEDIUM_OVER_PROB      = 0.58
MEDIUM_UNDER_PROB     = 0.45

# ============ VALUE BETTING ============
MIN_EV   = 0.03
MAX_EV   = 0.15
MIN_ODDS = 1.30

# ============ PERFORMANCE ============
# Parallel workers for xG enrichment (Bzzoiro has no rate limits)
XG_WORKERS = 8

# ============ DATA PATHS ============
DATA_DIR       = "data"
MATCHES_CSV    = "data/matches.csv"
MATCHES_XG_CSV = "data/matches_with_xg.csv"
XG_CACHE_CSV   = "data/xg_cache.csv"
